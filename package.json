{
  "name": "school-bell-system",
  "version": "1.0.3",
  "description": "Automated school bell scheduling system with audio playback and authentication",
  "main": "src/main/main.js",
  "homepage": "https://github.com/Nasrollah-Javdan/school-bell-system",
  "author": {
    "name": "Nasrollah-Javdan",
    "email": "veratechgh1@gmail.com",
    "url": "https://github.com/Nasrollah-Javdan"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nasrollah-Javdan/school-bell-system.git"
  },
  "bugs": {
    "url": "https://github.com/Nasrollah-Javdan/school-bell-system/issues"
  },
  "keywords": [
    "school",
    "bell",
    "scheduler",
    "electron",
    "audio",
    "automation",
    "education",
    "desktop-app"
  ],
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron . --dev --disable-gpu-sandbox --no-sandbox",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --win",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:win:plain": "npm run build:renderer && electron-builder --win --config.win.signAndEditExecutable=false",
    "dist": "npm run build",
    "pack": "npm run build:renderer && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "release": "npm run build:renderer && electron-builder --publish=always",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "clean": "rimraf dist node_modules package-lock.json && npm install"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-updater": "^6.1.7",
    "node-cron": "^4.1.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.2",
    "@electron-forge/maker-squirrel": "^7.8.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.1.0",
    "electron-builder": "^26.0.12",
    "rimraf": "^6.0.1",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.atizad.school-bell-system",
    "productName": "School Bell System",
    "copyright": "Copyright © 2025 AtizaD",
    "electronVersion": "37.1.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/dist/**/*",
      "src/renderer/assets/icons/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "audio",
        "to": "audio",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/tray-icon.png", 
        "to": "tray-icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/renderer/assets/icons/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "School Bell System"
    },
    "publish": {
      "provider": "github",
      "owner": "Nasrollah-Javdan",
      "repo": "school-bell-system",
      "private": false,
      "releaseType": "release"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}